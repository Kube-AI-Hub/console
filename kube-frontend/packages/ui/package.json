{
  "name": "@kube-ai-hub/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Presentation layer over ai-kit. No state, no requests, no i18n, no routing.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tailwind.preset": {
      "types": "./src/preset.ts",
      "import": "./src/preset.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kube-ai-hub/ai-kit": "link:../../../packages/ai-kit",
    "@kube-ai-hub/ai-surface": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:"
  }
}
