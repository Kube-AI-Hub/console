# 复制为 .env 后填写。.env 不入库。
#
# 控制台地址。B200：https://console-dev.brightaitoken.ai
# A100：https://agentplatform.phanthy.com
KA_BASE_URL=https://console-dev.brightaitoken.ai

# 集群名（URL 里的 /clusters/<id>）
KA_CLUSTER=default

# 管理员账号。密码会被 console 的登录页加密后提交，测试里用同一套逻辑。
KA_USERNAME=admin
KA_PASSWORD=

# Account used only by the login cases (`tests/kube-frontend/login`).
#
# Those cases sign out for real, and signing out revokes the session upstream, so
# sharing KA_USERNAME would log the rest of the run out and every later case would
# land on /login. Create a throwaway account and point these at it; they fall back
# to KA_USERNAME / KA_PASSWORD when left empty.
KA_LOGIN_USERNAME=
KA_LOGIN_PASSWORD=

# 是否无头运行
KA_HEADLESS=true

# 对比度阈值（WCAG AA 正文 4.5:1；次要文字 3:1）
KA_CONTRAST_TEXT=4.5
KA_CONTRAST_MUTED=3.0
